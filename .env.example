# ==========================================
# 极简配置（推荐：两端各仅需 1 条环境变量）
# ==========================================

# 1. 豆瓣认证 (直接填完整 Cookie 即可，脚本自动提取数字用户ID与CSRF码；或填 账号:密码)
DOUBAN_AUTH=

# 2. Trakt 认证 (直接填从控制台一键复制的 Access Token 即可，亦支持 Client_ID#Access_Token)
TRAKT_AUTH=

# ==========================================
# 传统分离配置 (完全兼容向下保留)
# ==========================================
# Trakt
TRAKT_CLIENT_ID=
TRAKT_ACCESS_TOKEN=

# 豆瓣
DOUBAN_USER_ID=
DOUBAN_COOKIE=

# ==========================================
# 可选同步设置 (豆瓣防风控延迟设置，单位：秒)
# ==========================================
SYNC_DELAY_MIN=3.0
SYNC_DELAY_MAX=6.0
